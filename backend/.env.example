# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/salons_virtuels_db

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_CHAT_PACK=price_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_SUBSCRIPTION=price_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FRONTEND_URL=http://localhost:5173

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@salonsvirtuels.com

# ─── SendGrid (Email notification) ───────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@salonsvirtuels.com

# ─── Twilio (SMS notification) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+12025550123
TWILIO_PHONE_NUMBER=+12025550123

# ─── API Externes ────────────────────────────────────────────────────────────
# Change de devises (ExchangeRate-API). CURRENCY_API_URL accepte {key} et {base}.
CURRENCY_API_KEY=your-exchangerate-api-key
CURRENCY_API_URL=
# Redis (cache des taux de change, TTL 1h)
REDIS_URL=redis://localhost:6379/0
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key
TOMTOM_API_KEY=your-tomtom-api-key
LOGISTICS_PROVIDER=openrouteservice
