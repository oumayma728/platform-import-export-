# ─── Environnement de TEST (optionnel) ───────────────────────────────────────
# Ce fichier documente la configuration des tests. Le conftest.py lit la
# variable TEST_DATABASE_URL directement depuis l'environnement.
#
# Pour lancer les tests sur PostgreSQL (recommandé pour la parité avec la prod) :
#   PowerShell : $env:TEST_DATABASE_URL="postgresql+psycopg://postgres:admin@localhost:5432/salons_virtuels_test"
#   (bash)     : export TEST_DATABASE_URL="postgresql+psycopg://postgres:admin@localhost:5432/salons_virtuels_test"
#
# Sans TEST_DATABASE_URL, les tests utilisent SQLite (sqlite:///./test.db).
# Le préfixe +psycopg utilise le driver psycopg v3 (compatible Python 3.14).
# psycopg2-binary ne s'installe pas sur Python 3.14 (pas de wheel) → rester sur psycopg.
TEST_DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/salons_virtuels_test

# ─── Variables repassées à l'app (via .env ou défaut) ────────────────────────
# Stripe en mode test : les valeurs CHANGEME activent les chemins "dev mode"
# (checkout mocké, webhook sans signature réelle) — à garder pour les tests.
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# Devises : clé vide → fallback open.er-api.com ; tests utilisent des mocks.
CURRENCY_API_KEY=
CURRENCY_API_URL=
REDIS_URL=

# Notifications : sans clé → mode simulation (log uniquement, NotificationLog).
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Exécution (depuis backend/) :
#   pytest                                    # SQLite + rapport de couverture
#   pytest -q tests/test_auth.py              # un fichier ciblé
#   $env:TEST_DATABASE_URL="postgresql+psycopg://..."; pytest   # PostgreSQL
