datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  MEMBRE
}

enum ValidationStatus {
  EN_ATTENTE_VALIDATION
  VALIDE
  REJETE
  SUSPENDU
}

enum ListingType {
  OFFRE
  DEMANDE
}

enum ListingStatus {
  ACTIVE
  SUSPENDUE
  CLOTUREE
}

enum ConversationStatus {
  SUGGEREE
  CONSULTEE
  EN_CONTACT
  EN_NEGOCIATION
  CONCLUE
  REJETEE
}

enum BillingStatus {
  GRATUIT
  LIMITE_ATTEINTE
  PAIEMENT_USAGE
  ABONNE
  ABONNEMENT_EXPIRE
}

enum TransactionType {
  PAIEMENT_USAGE
  ABONNEMENT
  REMBOURSEMENT
}

enum TransactionStatus {
  REUSSI
  ECHOUE
  EN_ATTENTE
}

// ============================================================
// PROFILES & AUTHENTICATION (3.1)
// ============================================================

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String           @map("password_hash")
  name         String           @map("name")
  phone        String           @unique
  status       ValidationStatus @default(EN_ATTENTE_VALIDATION)
  role         UserRole         @default(MEMBRE)

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  refreshTokens RefreshToken[]
  messages      Message[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Company {
  id                  String           @id @default(uuid())
  name                String
  isExporter          Boolean          @default(false) @map("is_exporter")
  isImporter          Boolean          @default(false) @map("is_importer")
  country             String
  description         String
  website             String?
  logoUrl             String?          @map("logo_url")
  registrationNumber  String?          @map("registration_number")
  certificationDocs   Json?            @map("certification_docs")

  users         User[]
  listings      Listing[]
  billingAccount BillingAccount?

  conversationsAsExporter Conversation[] @relation("ExporterConversations")
  conversationsAsImporter Conversation[] @relation("ImporterConversations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

// ============================================================
// LISTINGS / ANNONCES (3.2)
// ============================================================

model Listing {
  id        String        @id @default(uuid())
  companyId String        @map("company_id")
  company   Company       @relation(fields: [companyId], references: [id])

  type        ListingType
  title       String
  category    String
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @db.VarChar(3)
  priceUsd    Decimal?      @map("price_usd") @db.Decimal(12, 2)
  quantity    Decimal       @db.Decimal(12, 2)
  unit        String
  country     String
  incoterm    String
  deadline    DateTime?     @db.Date
  status      ListingStatus @default(ACTIVE)

  documents     ListingDocument[]
  conversations Conversation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([category])
  @@index([country])
  @@index([status])
  @@map("listings")
}

model ListingDocument {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fileUrl   String   @map("file_url")
  fileType  String   @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([listingId])
  @@map("listing_documents")
}

// ============================================================
// MESSAGERIE (3.3)
// ============================================================

model Conversation {
  id        String  @id @default(uuid())
  listingId String  @map("listing_id")
  listing   Listing @relation(fields: [listingId], references: [id])

  exporterCompanyId String  @map("exporter_company_id")
  exporterCompany   Company @relation("ExporterConversations", fields: [exporterCompanyId], references: [id])

  importerCompanyId String  @map("importer_company_id")
  importerCompany   Company @relation("ImporterConversations", fields: [importerCompanyId], references: [id])

  status ConversationStatus @default(SUGGEREE)

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([listingId])
  @@index([exporterCompanyId])
  @@index([importerCompanyId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id")
  sender   User   @relation(fields: [senderId], references: [id])

  content       String  @db.Text
  attachmentUrl String? @map("attachment_url")
  isRead        Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ============================================================
// FACTURATION & PAIEMENT (3.4)
// ============================================================

model BillingAccount {
  id        String  @id @default(uuid())
  companyId String  @unique @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  freeChatsUsed          Int           @default(0) @map("free_chats_used")
  status                 BillingStatus @default(GRATUIT)
  stripeCustomerId       String?       @map("stripe_customer_id")
  stripeSubscriptionId   String?       @map("stripe_subscription_id")
  cumulativeUsageSpend   Decimal       @default(0) @map("cumulative_usage_spend") @db.Decimal(12, 2)

  transactions PaymentTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("billing_accounts")
}

model PaymentTransaction {
  id               String            @id @default(uuid())
  billingAccountId String            @map("billing_account_id")
  billingAccount   BillingAccount    @relation(fields: [billingAccountId], references: [id])

  stripeEventId String            @unique @map("stripe_event_id")
  type          TransactionType
  amount        Decimal           @db.Decimal(12, 2)
  status        TransactionStatus

  createdAt DateTime @default(now()) @map("created_at")

  @@index([billingAccountId])
  @@map("payment_transactions")
}

// ============================================================
// AUDIT / SECURITY LOGGING
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ipAddress String   @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}



