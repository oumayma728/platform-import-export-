datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  MEMBRE
}

enum ValidationStatus {
  EN_ATTENTE_VALIDATION
  VALIDE
  REJETE
  SUSPENDU
}

enum ListingType {
  OFFRE
  DEMANDE
}

enum ListingStatus {
  ACTIF
  SUSPENDUE
  CLOTUREE
}

enum ConversationStatus {
  SUGGEREE
  CONSULTEE
  EN_CONTACT
  EN_NEGOCIATION
  CONCLUE
  REJETEE
}

enum BillingStatus {
  GRATUIT
  LIMITE_ATTEINTE
  PAIEMENT_USAGE
  ABONNE
  ABONNEMENT_EXPIRE
}

enum TransactionType {
  PAIEMENT_USAGE
  ABONNEMENT
  REMBOURSEMENT
}

enum TransactionStatus {
  REUSSI
  ECHOUE
  EN_ATTENTE
}

enum BillingInterval {
  MENSUEL
  ANNUEL
}

enum SubscriptionStatus {
  ACTIF
  ANNULE
  IMPAYE
  EXPIRE
}

enum ConversationAccessSource {
  GRATUIT
  PAIEMENT_A_L_USAGE
  ABONNEMENT
}

// ============================================================
// PROFILES & AUTHENTICATION
// ============================================================

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String           @map("password_hash")
  name         String           @map("name")
  phone        String           @unique
  status       ValidationStatus @default(EN_ATTENTE_VALIDATION)
  role         UserRole         @default(MEMBRE)

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  refreshTokens  RefreshToken[]
  messages       Message[]
  auditLogs      AuditLog[]
  billingAccount BillingAccount?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Company {
  id                 String           @id @default(uuid())
  name               String
  isExporter         Boolean          @default(false) @map("is_exporter")
  isImporter         Boolean          @default(false) @map("is_importer")
  country            String
  description        String
  website            String?
  logoUrl            String?          @map("logo_url")
  registrationNumber String?          @map("registration_number")
  certificationDocs  Json?            @map("certification_docs")
  validationStatus   ValidationStatus @default(EN_ATTENTE_VALIDATION) @map("validation_status")

  users    User[]
  listings Listing[]

  conversationsAsExporter Conversation[] @relation("ExporterConversations")
  conversationsAsImporter Conversation[] @relation("ImporterConversations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

// ============================================================
// LISTINGS / ANNONCES
// ============================================================

model Listing {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])

  type      ListingType
  title     String
  category  String
  price     Decimal       @db.Decimal(12, 2)
  currency  String        @db.VarChar(3)
  priceUsd  Decimal?      @map("price_usd") @db.Decimal(12, 2)
  quantity  Decimal       @db.Decimal(12, 2)
  unit      String
  country   String
  incoterm  String
  deadline  DateTime?     @db.Date
  status    ListingStatus @default(ACTIF)

  documents     ListingDocument[]
  conversations Conversation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([category])
  @@index([country])
  @@index([status])
  @@map("listings")
}

model ListingDocument {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([listingId])
  @@map("listing_documents")
}

// ============================================================
// MESSAGING
// ============================================================

model Conversation {
  id        String  @id @default(uuid())
  listingId String  @map("listing_id")
  listing   Listing @relation(fields: [listingId], references: [id])

  exporterCompanyId String  @map("exporter_company_id")
  exporterCompany   Company @relation("ExporterConversations", fields: [exporterCompanyId], references: [id])

  importerCompanyId String  @map("importer_company_id")
  importerCompany   Company @relation("ImporterConversations", fields: [importerCompanyId], references: [id])

  status ConversationStatus @default(SUGGEREE)

  messages             Message[]
  conversationAccesses ConversationAccess[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([listingId, exporterCompanyId, importerCompanyId])
  @@index([listingId])
  @@index([exporterCompanyId, updatedAt])
  @@index([importerCompanyId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id")
  sender   User   @relation(fields: [senderId], references: [id])

  content       String  @db.Text
  attachmentUrl String? @map("attachment_url")
  isRead        Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ============================================================
// BILLING & PAYMENTS
// ============================================================

model BillingAccount {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  freeChatsUsed        Int           @default(0) @map("free_chats_used")
  billingStatus        BillingStatus @default(GRATUIT) @map("billing_status")
  stripeCustomerId     String?       @unique @map("stripe_customer_id")
  cumulativeUsageSpend Decimal       @default(0) @map("cumulative_usage_spend") @db.Decimal(12, 2)

  // 1-to-1 Relation (to keep it simple only the active subscription is stored)
  subscription Subscription?

  transactions         PaymentTransaction[]
  conversationAccesses ConversationAccess[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@map("billing_accounts")
}

model SubscriptionPlan {
  id            String          @id @default(uuid())
  name          String
  interval      BillingInterval
  price         Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD") @db.VarChar(3)
  stripePriceId String          @unique @map("stripe_price_id")
  isActive      Boolean         @default(true) @map("is_active")

  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model Subscription {
  id String @id @default(uuid())

  // @unique enforces the 1-to-1 relation on this FK
  billingAccountId String         @unique @map("billing_account_id")
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  planId String           @map("plan_id")
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  status               SubscriptionStatus @default(ACTIF)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model ConversationAccess {
  id String @id @default(uuid())

  billingAccountId String @map("billing_account_id")
  conversationId   String @map("conversation_id")

  source ConversationAccessSource
  amount Decimal                  @default(0.00) @db.Decimal(10, 2)

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([billingAccountId, conversationId])
  @@index([conversationId])
  @@map("conversation_accesses")
}

model PaymentTransaction {
  id               String         @id @default(uuid())
  billingAccountId String         @map("billing_account_id")
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  type           TransactionType
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD") @db.VarChar(3)
  status         TransactionStatus
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")     // PAYS $2  =>  stripePaymentIntentId
  stripeInvoiceId       String? @unique @map("stripe_invoice_id")     // Subscription $92  =>  stripeInvoiceId

  stripeEventId  String?           @unique @map("stripe_event_id")
  idempotencyKey String?           @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([billingAccountId])
  @@map("payment_transactions")
}

model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique @map("event_id")
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_webhook_events")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String   @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}
